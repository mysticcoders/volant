{
  "sourceLanguage": "en",
  "strings": {
    "NSAppleEventsUsageDescription": {
      "comment": "Permission prompt macOS shows the first time Volant asks for this access.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volant asks macOS to show its restart, shut down and log out confirmations and asks System Events to switch appearance or menu bar hiding, only when you choose those commands. During a Focus session that blocks websites, it asks the browser in front for its current tab’s address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant pide a macOS que muestre sus confirmaciones de reinicio, apagado y cierre de sesión y pide a System Events que cambie el aspecto o la ocultación de la barra de menús, solo cuando eliges esos comandos. Durante una sesión de concentración que bloquea sitios web, pide al navegador en primer plano la dirección de su pestaña actual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant bittet macOS, die Bestätigungen für Neustart, Ausschalten und Abmelden anzuzeigen, und bittet System Events, das Erscheinungsbild oder das Ausblenden der Menüleiste zu wechseln, nur wenn du diese Befehle wählst. Während einer Fokussitzung, die Websites blockiert, fragt es den Browser im Vordergrund nach der Adresse seines aktuellen Tabs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant demande à macOS d’afficher ses confirmations de redémarrage, d’extinction et de déconnexion, et demande à System Events de changer l’apparence ou le masquage de la barre des menus, uniquement lorsque vous choisissez ces commandes. Pendant une session de concentration qui bloque des sites web, il demande au navigateur au premier plan l’adresse de son onglet actuel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant chiede a macOS di mostrare le conferme di riavvio, spegnimento e logout e chiede a System Events di cambiare l’aspetto o la scomparsa della barra dei menu, solo quando scegli questi comandi. Durante una sessione di concentrazione che blocca siti web, chiede al browser in primo piano l’indirizzo della sua scheda attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volantは、それらのコマンドを選んだときだけ、再起動・システム終了・ログアウトの確認の表示をmacOSに、外観やメニューバーの自動非表示の切り替えをSystem Eventsに依頼します。Webサイトをブロックする集中セッション中は、前面のブラウザに現在のタブのアドレスを問い合わせます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅当你选择相应命令时，Volant 才会请 macOS 显示重新启动、关机和注销确认，并请 System Events 切换外观或菜单栏自动隐藏。在阻止网站的专注时段中，它会向最前面的浏览器询问当前标签页的地址。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Volant pede ao macOS que mostre as confirmações de reiniciar, desligar e encerrar sessão e pede ao System Events que alterne a aparência ou a ocultação da barra de menus, somente quando você escolhe esses comandos. Durante uma sessão de foco que bloqueia sites, ele pergunta ao navegador em primeiro plano o endereço da aba atual."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Volant pede ao macOS que mostre as confirmações de reiniciar, desligar e terminar sessão e pede ao System Events que alterne o aspeto ou a ocultação da barra de menus, apenas quando escolhe esses comandos. Durante uma sessão de foco que bloqueia sites, pergunta ao navegador em primeiro plano o endereço do separador atual."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant은 해당 명령을 선택할 때만 macOS에 재시동, 시스템 종료, 로그아웃 확인을 표시하도록, System Events에 화면 모드나 메뉴 막대 자동 가리기를 전환하도록 요청합니다. 웹사이트를 차단하는 집중 세션 중에는 앞에 있는 브라우저에 현재 탭의 주소를 묻습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant vraagt macOS de bevestigingen voor herstarten, uitschakelen en afmelden te tonen en vraagt System Events de weergave of het verbergen van de menubalk te wisselen, alleen als je die opdrachten kiest. Tijdens een focussessie die websites blokkeert, vraagt het de browser op de voorgrond naar het adres van het huidige tabblad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant prosi macOS o wyświetlenie potwierdzeń ponownego uruchomienia, wyłączenia i wylogowania oraz prosi System Events o przełączenie wyglądu lub ukrywania paska menu, tylko gdy wybierzesz te polecenia. Podczas sesji skupienia, która blokuje witryny, pyta przeglądarkę na pierwszym planie o adres bieżącej karty."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant просит macOS показать подтверждения перезагрузки, выключения и выхода из системы и просит System Events переключить оформление или скрытие строки меню, только когда вы выбираете эти команды. Во время сеанса фокусировки, блокирующего сайты, он запрашивает у браузера на переднем плане адрес текущей вкладки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant просить macOS показати підтвердження перезапуску, вимкнення й виходу із системи та просить System Events перемкнути вигляд або приховування рядка меню, лише коли ви вибираєте ці команди. Під час сеансу зосередження, що блокує сайти, він запитує в браузера на передньому плані адресу поточної вкладки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant, yalnızca bu komutları seçtiğinizde macOS’ten yeniden başlatma, kapatma ve oturumu kapatma onaylarını göstermesini, System Events’ten de görünümü veya menü çubuğunun gizlenmesini değiştirmesini ister. Web sitelerini engelleyen bir odak oturumu sırasında öndeki tarayıcıdan geçerli sekmesinin adresini ister."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "comment": "Permission prompt macOS shows the first time Volant asks for this access.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volant lists connected Bluetooth devices when you open the Bluetooth command."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant muestra los dispositivos Bluetooth conectados cuando abres el comando Bluetooth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant listet verbundene Bluetooth-Geräte auf, wenn du den Bluetooth-Befehl öffnest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant elenca i dispositivi Bluetooth connessi quando apri il comando Bluetooth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant affiche la liste des appareils Bluetooth connectés lorsque vous ouvrez la commande Bluetooth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当你打开“蓝牙”命令时，Volant会列出已连接的蓝牙设备。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant показывает подключенные устройства Bluetooth, когда вы открываете команду Bluetooth."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Volant lista os dispositivos Bluetooth conectados quando você abre o comando Bluetooth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetoothコマンドを開いたときに、Volantは接続中のBluetoothデバイスを一覧表示します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant toont verbonden Bluetooth-apparaten wanneer je het Bluetooth-commando opent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth 명령을 열면 Volant가 연결된 Bluetooth 기기를 나열합니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant показує під’єднані пристрої Bluetooth, коли ви відкриваєте команду Bluetooth."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant wyświetla podłączone urządzenia Bluetooth po otwarciu polecenia Bluetooth."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant, Bluetooth komutunu açtığınızda bağlı Bluetooth aygıtlarını listeler."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Volant lista os dispositivos Bluetooth ligados quando abre o comando Bluetooth."
          }
        }
      }
    },
