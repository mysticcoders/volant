    "NSMicrophoneUsageDescription": {
      "comment": "Permission prompt macOS shows the first time Volant asks for this access.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volant transcribes dictation on this Mac. Audio is never sent anywhere and is not saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant transcribe el dictado en tu Mac. El audio nunca se envía a ningún sitio y no se guarda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant transkribiert Diktate auf diesem Mac. Audio wird nie gesendet und nicht gespeichert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant trascrive la dettatura su questo Mac. L’audio non viene mai inviato da nessuna parte e non viene salvato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant transcrit la dictée sur ce Mac. L’audio n’est jamais envoyé nulle part et n’est pas enregistré."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant在这台Mac上转写听写内容。音频永远不会被发送到任何地方，也不会被存储。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant расшифровывает диктовку на этом Mac. Аудио никуда не отправляется и не сохраняется."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Volant transcreve o ditado neste Mac. O áudio nunca é enviado a lugar algum e não é salvo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volantは音声入力をこのMac上で文字起こしします。音声がどこかに送信されたり、保存されたりすることはありません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant transcribeert dictaten op deze Mac. Audio wordt nergens naartoe verstuurd en niet bewaard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant는 이 Mac에서 받아쓰기를 변환합니다. 오디오는 어디로도 전송되지 않으며 저장되지 않습니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant транскрибує диктування на цьому Mac. Аудіо ніколи нікуди не надсилається й не зберігається."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant transkrybuje dyktowanie na tym Macu. Dźwięk nigdy nie jest nigdzie wysyłany ani zachowywany."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant dikteyi bu Mac’te yazıya döker. Ses hiçbir yere gönderilmez ve kaydedilmez."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Volant transcreve o ditado neste Mac. O áudio nunca é enviado para lado nenhum e não é guardado."
          }
        }
      }
    }
  },
  "version": "1.0"
}
