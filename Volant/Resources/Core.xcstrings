            "state": "needs_review",
            "value": "AA alleen voor grote tekst"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "큰 텍스트에만 AA"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AA лише для великого тексту"
