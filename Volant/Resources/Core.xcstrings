    },
    "The response stopped before completion. You can try again.": {
      "comment": "AI connection error",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La respuesta se detuvo antes de completarse. Puedes volver a intentarlo."
          }
        },
        "de": {
          "stringUnit": {
