    "Appearance changed in the configuration file. Reload Configuration before changing it again.": {
      "comment": "Appearance settings error when config.json changed underneath",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La apariencia cambió en el archivo de configuración. Vuelve a cargar la configuración antes de cambiarla de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Erscheinungsbild wurde in der Konfigurationsdatei geändert. Lade die Konfiguration neu, bevor du es erneut änderst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’aspetto è cambiato nel file di configurazione. Ricarica la configurazione prima di modificarlo di nuovo."
