    "Appearance changed in the configuration file. Reload Configuration before changing it again.": {
      "comment": "Appearance settings error when config.json changed underneath",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La apariencia cambió en el archivo de configuración. Vuelve a cargar la configuración antes de cambiarla de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Erscheinungsbild wurde in der Konfigurationsdatei geändert. Lade die Konfiguration neu, bevor du es erneut änderst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’aspetto è cambiato nel file di configurazione. Ricarica la configurazione prima di modificarlo di nuovo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’apparence a changé dans le fichier de configuration. Rechargez la configuration avant de la modifier à nouveau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "外观已在配置文件中更改。请先重新载入配置，再进行更改。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оформление изменилось в файле конфигурации. Перезагрузите конфигурацию, прежде чем менять его снова."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A aparência mudou no arquivo de configuração. Recarregue a Configuração antes de alterá-la novamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "構成ファイルで外観が変更されました。再度変更する前に「構成を再読み込み」を実行してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De weergave is gewijzigd in het configuratiebestand. Laad configuratie opnieuw voordat je deze weer wijzigt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "구성 파일에서 화면 모드가 변경되었습니다. 다시 변경하기 전에 구성을 다시 불러오십시오."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вигляд змінено у файлі конфігурації. Перезавантажте конфігурацію, перш ніж змінювати його знову."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wygląd zmienił się w pliku konfiguracji. Wczytaj ponownie konfigurację przed kolejną zmianą."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Görünüm yapılandırma dosyasında değişti. Yeniden değiştirmeden önce Yapılandırmayı Yeniden Yükle’yi kullanın."
          }
        }
      }
    },
