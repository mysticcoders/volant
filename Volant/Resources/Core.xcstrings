{
  "sourceLanguage": "en",
  "strings": {
    "AA for large text only": {
      "comment": "Calculator color contrast verdict; AA and AAA are WCAG levels",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AA solo para texto grande"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AA nur für großen Text"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AA solo per testo grande"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AA pour le texte de grande taille uniquement"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅大号文本符合AA"
          }
