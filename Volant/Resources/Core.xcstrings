            "value": "Die Antwort brach vor dem Abschluss ab. Du kannst es erneut versuchen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La risposta si è interrotta prima del completamento. Puoi riprovare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La réponse s’est arrêtée avant la fin. Vous pouvez réessayer."
          }
        }
      }
    },
    "The server rejected access. Check your API key and model permissions.": {
      "comment": "AI connection error for HTTP 401 or 403",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El servidor denegó el acceso. Comprueba tu clave de API y los permisos del modelo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Server hat den Zugriff verweigert. Prüfe deinen API-Schlüssel und die Modellberechtigungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il server ha negato l’accesso. Controlla la chiave API e i permessi del modello."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le serveur a refusé l’accès. Vérifiez votre clé API et les autorisations du modèle."
          }
        }
      }
    },
    "The server returned an unsupported response. Check the provider and endpoint.": {
      "comment": "AI connection error",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El servidor devolvió una respuesta no compatible. Comprueba el proveedor y el endpoint."
          }
        },
        "de": {
          "stringUnit": {
