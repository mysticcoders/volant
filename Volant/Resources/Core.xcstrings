            "value": "Eso no es un tema de Raycast. Usa un archivo JSON de tema o un enlace de tema de Raycast o themes.ray.so."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das ist kein Raycast-Theme. Verwende eine Theme-JSON-Datei oder einen Theme-Link von Raycast oder themes.ray.so."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è un tema Raycast. Usa un file JSON del tema o un link a un tema da Raycast o themes.ray.so."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce n’est pas un thème Raycast. Utilisez un fichier JSON de thème, ou un lien de thème de Raycast ou de themes.ray.so."
          }
        }
      }
    },
    "That theme is larger than a Raycast theme can be.": {
      "comment": "Raycast theme import error",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
