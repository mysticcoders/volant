    "Add an API key in AI Settings before connecting.": {
      "comment": "AI connection error",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Añade una clave de API en los ajustes de IA antes de conectarte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Füge in den AI-Einstellungen einen API-Schlüssel hinzu, bevor du dich verbindest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aggiungi una chiave API nelle impostazioni AI prima di connetterti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajoutez une clé API dans les réglages IA avant de vous connecter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "连接前请先在AI设置中添加API密钥。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перед подключением добавьте ключ API в настройках ИИ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adicione uma chave da API nos Ajustes de IA antes de conectar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "接続する前にAIの設定でAPIキーを追加してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
