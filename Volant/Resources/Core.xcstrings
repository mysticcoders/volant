          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il server ha restituito una risposta non supportata. Controlla il fornitore e l’endpoint."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le serveur a renvoyé une réponse non prise en charge. Vérifiez le fournisseur et le point de terminaison."
          }
        }
      }
    },
    "The server's rate or usage limit was reached. Try again later.": {
      "comment": "AI connection error for HTTP 429",
      "localizations": {
