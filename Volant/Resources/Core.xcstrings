    "Shortcut did not finish successfully. Open Shortcuts to review its permissions and actions.": {
      "comment": "Apple Shortcuts error",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El atajo no terminó correctamente. Abre Atajos para revisar sus permisos y acciones."
