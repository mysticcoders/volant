    "Allow %@ to go online?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ den Onlinezugriff erlauben?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Permitir que %@ se conecte a internet?"
          }
        },
        "fr" : {
          "stringUnit" : {
