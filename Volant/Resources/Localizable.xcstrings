    "Clipboard history can’t access its encryption key. Unlock your login Keychain or allow access, then retry.": {
      "comment": "Clipboard history error",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El historial del portapapeles no puede acceder a su clave de cifrado. Desbloquea el llavero de inicio de sesión o permite el acceso y vuelve a intentarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Verlauf der Zwischenablage kann nicht auf seinen Schlüssel zugreifen. Entsperre deinen Anmeldeschlüsselbund oder erlaube den Zugriff und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La cronologia degli appunti non può accedere alla sua chiave di crittografia. Sblocca il Portachiavi login o consenti l’accesso, poi riprova."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’historique du presse-papiers ne peut pas accéder à sa clé de chiffrement. Déverrouillez votre trousseau de session ou autorisez l’accès, puis réessayez."
          }
        }
      }
    },
    "Clipboard history’s encryption key couldn’t be read. Existing history has been preserved. Check Keychain access, then retry.": {
      "comment": "Clipboard history error",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo leer la clave de cifrado del historial del portapapeles. Se conservó el historial existente. Revisa el acceso al Llavero y vuelve a intentarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Schlüssel des Zwischenablageverlaufs konnte nicht gelesen werden. Der vorhandene Verlauf bleibt erhalten. Prüfe den Schlüsselbundzugriff und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile leggere la chiave di crittografia della cronologia degli appunti. La cronologia esistente è stata conservata. Controlla l’accesso al Portachiavi, poi riprova."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La clé de chiffrement de l’historique du presse-papiers n’a pas pu être lue. L’historique existant a été conservé. Vérifiez l’accès au trousseau, puis réessayez."
          }
        }
      }
    },
    "Clipboard history’s encryption key is missing. Existing history has been preserved. Restore access to its original Keychain key, then retry.": {
      "comment": "Clipboard history error",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Falta la clave de cifrado del historial del portapapeles. Se conservó el historial existente. Restablece el acceso a su clave original del Llavero y vuelve a intentarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Schlüssel des Zwischenablageverlaufs fehlt. Der vorhandene Verlauf bleibt erhalten. Stelle den Zugriff auf den ursprünglichen Schlüsselbundeintrag wieder her und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Manca la chiave di crittografia della cronologia degli appunti. La cronologia esistente è stata conservata. Ripristina l’accesso alla chiave originale nel Portachiavi, poi riprova."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La clé de chiffrement de l’historique du presse-papiers est manquante. L’historique existant a été conservé. Rétablissez l’accès à sa clé d’origine dans le trousseau, puis réessayez."
          }
        }
      }
    },
    "Clipboard history’s storage is unavailable. Check available disk space and access, then retry.": {
      "comment": "Clipboard history error",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El almacenamiento del historial del portapapeles no está disponible. Revisa el espacio libre en disco y el acceso, y vuelve a intentarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
