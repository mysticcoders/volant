            "value" : "Cada uma é executada como WebAssembly em um auxiliar isolado separado, sem acesso aos seus arquivos ou à rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Каждое запускается как WebAssembly в отдельном изолированном помощнике, без доступа к вашим файлам и сети."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Her biri, dosyalarınıza veya ağa erişimi olmayan ayrı bir korumalı yardımcıda WebAssembly olarak çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кожне виконується як WebAssembly в окремому ізольованому помічнику без доступу до ваших файлів або мережі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
