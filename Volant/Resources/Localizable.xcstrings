            "value": "%@ è disattivato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ est désactivée."
          }
        }
      }
    },
    "%@ is enabled.": {
      "comment": "A Herdr machine was turned on",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ está activada."
