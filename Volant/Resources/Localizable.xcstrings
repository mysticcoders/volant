    "Turn off to stop every community extension at once. Your choices are kept for when you turn them back on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desactívalo para detener todas las extensiones de la comunidad a la vez. Tus elecciones se conservan para cuando vuelvas a activarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deaktivieren, um alle Community-Erweiterungen auf einmal zu stoppen. Deine Auswahl bleibt erhalten, bis du sie wieder aktivierst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disattiva per interrompere tutte le estensioni della community. Le tue scelte vengono mantenute per quando le riattivi."
          }
        },
        "fr": {
