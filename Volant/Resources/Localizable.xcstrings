            "value": "%@ è attivato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ est activée."
          }
        }
      }
    },
    "%@ only. %@": {
      "comment": "Herdr footer tooltip when Settings limits it to one agent harness, such as Claude Code",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ only. %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo %1$@. %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur %1$@. %2$@"
