          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menu Volant"
          }
        }
      }
    },
    "Volant moves it to the Trash and removes host access that no other extension needs.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant la mueve a la Papelera y elimina el acceso a hosts que ninguna otra extensión necesita."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant legt sie in den Papierkorb und entfernt Hostzugriffe, die keine andere Erweiterung braucht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant la sposta nel Cestino e rimuove l’accesso agli host non necessari ad altre estensioni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant la place dans la corbeille et retire l’accès aux hôtes dont aucune autre extension n’a besoin."
          }
        }
      }
    },
    "Volant no longer uses Accessibility. To remove its access, turn off Volant in Privacy & Security → Accessibility.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant ya no usa Accesibilidad. Para retirarle el acceso, desactiva Volant en Privacidad y seguridad → Accesibilidad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant nutzt die Bedienungshilfen nicht mehr. Um den Zugriff zu entfernen, deaktiviere Volant unter Datenschutz & Sicherheit → Bedienungshilfen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant non usa più Accessibilità. Per rimuoverne l’accesso, disattiva Volant in Privacy e sicurezza → Accessibilità."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant n’utilise plus Accessibilité. Pour retirer son accès, désactivez Volant dans Confidentialité et sécurité → Accessibilité."
          }
        }
      }
    },
    "Volant runs up to %lld conversations at once. End one to start another.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant ejecuta hasta %lld conversaciones a la vez. Termina una para empezar otra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant führt bis zu %lld Konversationen gleichzeitig aus. Beende eine, um eine neue zu starten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant gestisce fino a %lld conversazioni alla volta. Terminane una per avviarne un’altra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant exécute jusqu’à %lld conversations à la fois. Terminez-en une pour en démarrer une autre."
          }
        }
      }
    },
    "Volant sends only what you write here and anything you attach with @. Sign in through the provider’s CLI before starting.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant solo envía lo que escribes aquí y lo que adjuntas con @. Inicia sesión con la CLI del proveedor antes de empezar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant sendet nur, was du hier schreibst und mit @ anhängst. Melde dich vor dem Start über die CLI des Anbieters an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant invia solo ciò che scrivi qui e ciò che alleghi con @. Accedi tramite la CLI del fornitore prima di iniziare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volant envoie uniquement ce que vous écrivez ici et ce que vous joignez avec @. Connectez-vous via la CLI du fournisseur avant de commencer."
