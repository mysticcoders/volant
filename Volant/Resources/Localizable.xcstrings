{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "shouldTranslate": false
    },
    " and ": {
      "comment": "Separator between access token names in an extension error, with its spaces",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": " y "
          }
        }
      }
    },
    "%@ %@ asks for new access, so it is off. Turn it on to review it.": {
      "comment": "Settings → Extensions notice; the values are the extension name and version",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ asks for new access, so it is off. Turn it on to review it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ %2$@ solicita nuevos accesos, así que está desactivada. Actívala para revisarla."
          }
        }
      }
    },
    "%@ %@ was withdrawn from the catalog and can’t be installed.": {
      "comment": "Extension catalog error; the values are the extension name and version",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ was withdrawn from the catalog and can’t be installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ %2$@ se retiró del catálogo y no se puede instalar."
          }
        }
      }
    },
    "%@ New copies aren’t being saved.": {
      "comment": "Clipboard history status; the value is the error that stopped it",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ No se están guardando las nuevas copias."
          }
        }
      }
    },
    "%@ Volant keeps it in your Keychain and adds it only to requests to %@. The extension never sees it.": {
      "comment": "Extension token field note; the values are the extension's own help text and a web host",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ Volant keeps it in your Keychain and adds it only to requests to %2$@. The extension never sees it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ Volant la guarda en tu Llavero y solo la añade a las solicitudes a %2$@. La extensión nunca la ve."
          }
        }
      }
    },
    "%@ alias": {
      "comment": "Accessibility label of an app's alias field in App Shortcuts; the value is the app name",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alias de %@"
          }
        }
      }
    },
    "%@ appearance": {
      "comment": "Accessibility label of an appearance tile; the value is System, Light or Dark",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aspecto %@"
          }
        }
      }
    },
    "%@ color theme": {
      "comment": "Accessibility label of a color theme tile; the value is the theme name",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tema de color %@"
          }
        }
      }
    },
    "%@ disconnected during dictation, so its volume wasn’t restored. Check its volume when you reconnect it.": {
      "comment": "The name is an audio output device",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ se desconectó durante el dictado, así que no se restauró su volumen. Revisa su volumen cuando lo vuelvas a conectar."
          }
        }
      }
    },
    "%@ equals %@": {
      "comment": "Accessibility label for a calculator answer",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ equals %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ es igual a %2$@"
          }
        }
      }
    },
    "%@ is a dark theme, so Volant stays dark while it is selected. Choose System or Volant to use this setting.": {
      "comment": "Appearance settings footer; the value is a color theme name",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ es un tema oscuro, así que Volant se mantiene oscuro mientras esté seleccionado. Elige Sistema o Volant para usar este ajuste."
          }
        }
      }
    },
    "%@ is a light theme, so Volant stays light while it is selected. Choose System or Volant to use this setting.": {
      "comment": "Appearance settings footer; the value is a color theme name",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ es un tema claro, así que Volant se mantiene claro mientras esté seleccionado. Elige Sistema o Volant para usar este ajuste."
          }
        }
      }
    },
    "%@ is bundled with Volant and can’t be replaced.": {
      "comment": "Extension catalog error",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ viene incluida con Volant y no se puede reemplazar."
          }
        }
      }
    },
    "%@ is disabled.": {
      "comment": "A Herdr machine was turned off",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ está desactivada."
          }
        }
      }
    },
    "%@ is enabled.": {
      "comment": "A Herdr machine was turned on",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ está activada."
          }
        }
      }
    },
    "%@ only. %@": {
      "comment": "Herdr footer tooltip when Settings limits it to one agent harness, such as Claude Code",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ only. %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo %1$@. %2$@"
          }
        }
      }
    },
    "%@ returned nothing.": {
      "comment": "Launcher notice when an extension returns no rows",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ no devolvió nada."
          }
        }
      }
    },
    "%@ shortcut %@": {
      "comment": "Accessibility label after saving a shortcut; the values are the command name and Saved or Removed",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ shortcut %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atajo de %1$@: %2$@"
          }
        }
      }
    },
    "%@ shortcut unavailable: %@": {
      "comment": "Settings error when a global shortcut can't be registered; the values are the command name and the key combination",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ shortcut unavailable: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atajo de %1$@ no disponible: %2$@"
          }
        }
      }
    },
    "%@ shortcut: %@": {
      "comment": "Accessibility label of a shortcut control; the values are the command name and its shortcut",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ shortcut: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atajo de %1$@: %2$@"
          }
        }
      }
    },
    "%@ shortcut: Not set": {
      "comment": "Accessibility label of a shortcut control with no shortcut; the value is the command name",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atajo de %@: sin asignar"
          }
        }
      }
    },
    "%@ was installed but couldn’t be loaded. Check the Extensions folder.": {
      "comment": "Extension catalog error",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ se instaló, pero no se pudo cargar. Revisa la carpeta Extensiones."
          }
        }
      }
    },
    "%@ was withdrawn from the extension catalog. Update or uninstall it.": {
      "comment": "Extension error; the value is the extension name",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ se retiró del catálogo de extensiones. Actualízala o desinstálala."
          }
        }
      }
    },
    "%@ was withdrawn from the extension catalog: %@ Update or uninstall it.": {
      "comment": "Extension error; the values are the extension name and the catalog's reason",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ was withdrawn from the extension catalog: %2$@ Update or uninstall it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ se retiró del catálogo de extensiones: %2$@ Actualízala o desinstálala."
          }
        }
      }
    },
    "%@ · %@ · Muted": {
      "comment": "Audio output name, volume level and its muted state",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@ · Muted"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · %2$@ · Silenciado"
          }
        }
      }
    },
