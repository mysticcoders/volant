    "The notes folder couldn’t be read. Existing notes and unsaved edits have been kept. Check folder access, then retry.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo leer la carpeta de notas. Se han conservado las notas existentes y los cambios sin guardar. Comprueba el acceso a la carpeta y vuelve a intentarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Notizenordner konnte nicht gelesen werden. Vorhandene Notizen und nicht gesicherte Änderungen bleiben erhalten. Prüfe den Ordnerzugriff und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile leggere la cartella delle note. Le note esistenti e le modifiche non salvate sono state mantenute. Controlla l’accesso alla cartella, poi riprova."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le dossier des notes n’a pas pu être lu. Les notes existantes et les modifications non enregistrées ont été conservées. Vérifiez l’accès au dossier, puis réessayez."
          }
        }
      }
