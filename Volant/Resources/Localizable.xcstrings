    "System Settings": {
      "comment": "Detail of the row that opens Wi-Fi or Bluetooth settings\nLauncher section title for System Settings panes\nResult row kind label",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajustes del Sistema"
          }
        },
        "de": {
