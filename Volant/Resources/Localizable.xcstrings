    "%@ %@ asks for new access, so it is off. Turn it on to review it." : {
      "comment" : "Settings → Extensions notice; the values are the extension name and version",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ fordert neuen Zugriff an und ist daher aus. Schalte es ein, um es zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ asks for new access, so it is off. Turn it on to review it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ solicita nuevos accesos, así que está desactivada. Actívala para revisarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ demande un nouvel accès, elle est donc désactivée. Activez-la pour l’examiner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ richiede nuovi accessi, quindi è disattivata. Attivala per esaminarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@が新しいアクセスを要求しているため、オフになっています。確認するにはオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@에서 새 접근 권한을 요청하여 꺼져 있습니다. 검토하려면 켜십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ vraagt om nieuwe toegang en staat daarom uit. Zet de extensie aan om dit te bekijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ prosi o nowy dostęp, więc jest wyłączone. Włącz je, aby to przejrzeć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ solicita novo acesso e por isso está desativada. Ative-a para revisá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ запрашивает новый доступ, поэтому выключено. Включите, чтобы проверить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ yeni erişim istiyor, bu nedenle kapalı. İncelemek için açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ запитує новий доступ, тому вимкнено. Увімкніть, щоб переглянути."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@请求了新的访问权限，因此已关闭。打开它以进行检查。"
          }
        }
      }
    },
    "%@ %@ was withdrawn from the catalog and can’t be installed." : {
      "comment" : "Extension catalog error; the values are the extension name and version",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ wurde aus dem Katalog zurückgezogen und kann nicht installiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ was withdrawn from the catalog and can’t be installed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ se retiró del catálogo y no se puede instalar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ a été retirée du catalogue et ne peut pas être installée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ è stata ritirata dal catalogo e non può essere installata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@はカタログから取り下げられたため、インストールできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ 항목이 카탈로그에서 철회되어 설치할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ is uit de catalogus teruggetrokken en kan niet worden geïnstalleerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ wycofano z katalogu i nie można go zainstalować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ foi retirada do catálogo e não pode ser instalada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ отозвано из каталога, и его нельзя установить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ katalogdan geri çekildi ve yüklenemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ вилучено з каталогу, і його не можна інсталювати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@已从目录中撤回，无法安装。"
          }
        }
      }
    },
