    "Uses your %@": {
      "comment": "Extension permission summary item; the value names an access token, such as GitHub token",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa tu %@"
          }
        },
        "de": {
