    "This translation is a beta. It was drafted without review by a native speaker, so some wording may be wrong or unnatural.": {
      "comment": "About settings footer, shown only when Volant runs in a translated language",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta traducción es una beta. Se redactó sin la revisión de un hablante nativo, así que algunas expresiones pueden ser incorrectas o poco naturales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Übersetzung ist eine Beta. Sie wurde ohne Prüfung durch Muttersprachler erstellt, daher können manche Formulierungen falsch oder unnatürlich sein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa traduzione è in beta. È stata redatta senza la revisione di un madrelingua, quindi alcune formulazioni potrebbero essere errate o poco naturali."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette traduction est une bêta. Elle a été rédigée sans relecture par un locuteur natif ; certaines formulations peuvent être erronées ou peu naturelles."
          }
        }
      }
    },
    "This version": {
      "localizations": {
        "es": {
          "stringUnit": {
