          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Premi per aprire o portare in primo piano questa app. Premi di nuovo quando è in primo piano per nasconderla. Usa Comando, Controllo o Opzione con un tasto."
