            "value" : "Met Volant meegeleverde extensies kunnen niet worden verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rozszerzeń dołączonych do Volant nie można odinstalować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
