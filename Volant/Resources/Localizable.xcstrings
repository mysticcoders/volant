        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorisez l’accès Bluetooth pour lister les appareils connectés."
          }
        }
      }
    },
    "Allow Location access to show Wi-Fi network names. Showing Wi-Fi never reads your coordinates.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite el acceso a la ubicación para mostrar los nombres de las redes Wi-Fi. Mostrar las redes Wi-Fi nunca lee tus coordenadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaube den Zugriff auf den Standort, um WLAN-Namen anzuzeigen. Beim Anzeigen von WLAN werden nie deine Koordinaten gelesen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consenti l’accesso alla posizione per mostrare i nomi delle reti Wi-Fi. Mostrare le reti Wi-Fi non legge mai le tue coordinate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorisez l’accès à la localisation pour afficher les noms des réseaux Wi-Fi. L’affichage du Wi-Fi ne lit jamais vos coordonnées."
          }
        }
      }
    },
