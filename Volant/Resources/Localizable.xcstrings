                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@: %2$lld malformed entry skipped."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@: %2$lld malformed entries skipped."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "%1$@: se omitió %2$lld entrada mal formada."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "%1$@: se omitieron %2$lld entradas mal formadas."
                }
              }
