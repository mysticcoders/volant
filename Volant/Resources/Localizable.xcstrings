    "%@ returned nothing.": {
      "comment": "Launcher notice when an extension returns no rows",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ no devolvió nada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ hat nichts zurückgegeben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ non ha restituito nulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ n’a rien renvoyé."
          }
        }
      }
    },
    "%@ shortcut %@": {
      "comment": "Accessibility label after saving a shortcut; the values are the command name and Saved or Removed",
      "localizations": {
