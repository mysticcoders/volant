            "value": "Synchroniser les réglages avec iCloud"
          }
        }
      }
    },
    "Synced settings exceed iCloud's 1 MB limit. Remove large snippets to resume syncing.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los ajustes sincronizados superan el límite de 1 MB de iCloud. Elimina fragmentos grandes para reanudar la sincronización."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die synchronisierten Einstellungen überschreiten das iCloud-Limit von 1 MB. Entferne große Textbausteine, um die Synchronisierung fortzusetzen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le impostazioni sincronizzate superano il limite di 1 MB di iCloud. Rimuovi i frammenti più grandi per riprendere la sincronizzazione."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les réglages synchronisés dépassent la limite de 1 Mo d’iCloud. Supprimez les extraits volumineux pour reprendre la synchronisation."
          }
        }
      }
    },
    "System": {
