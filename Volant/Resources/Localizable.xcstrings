    "Some clipboard items couldn’t be read. Existing history has been preserved. Check access to its original Keychain key, then retry.": {
      "comment": "Clipboard history error",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudieron leer algunos ítems del portapapeles. Se ha conservado el historial existente. Comprueba el acceso a su clave original del Llavero y vuelve a intentarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einige Objekte der Zwischenablage konnten nicht gelesen werden. Der vorhandene Verlauf bleibt erhalten. Prüfe den Zugriff auf den ursprünglichen Schlüsselbund-Schlüssel und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alcuni elementi degli appunti non sono leggibili. La cronologia esistente è stata conservata. Controlla l’accesso alla chiave originale nel Portachiavi, poi riprova."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certains éléments du presse-papiers n’ont pas pu être lus. L’historique existant a été conservé. Vérifiez l’accès à sa clé d’origine dans le trousseau, puis réessayez."
          }
        }
      }
    },
