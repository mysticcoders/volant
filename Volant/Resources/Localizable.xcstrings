    "%@ New copies aren’t being saved." : {
      "comment" : "Clipboard history status; the value is the error that stopped it",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Neue Kopien werden nicht gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ No se están guardando las nuevas copias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Les nouvelles copies ne sont pas enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Le nuove copie non vengono salvate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 新しいコピーは保存されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 새 복사본이 저장되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Nieuwe kopieën worden niet bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Nowe kopie nie są zachowywane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Novas cópias não estão sendo salvas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Новые копии не сохраняются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Yeni kopyalar kaydedilmiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Нові копії не зберігаються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@不会保存新的拷贝。"
          }
        }
      }
    },
    "%@ Volant keeps it in your Keychain and adds it only to requests to %@. The extension never sees it." : {
      "comment" : "Extension token field note; the values are the extension's own help text and a web host",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ Volant bewahrt es in deinem Schlüsselbund auf und fügt es nur Anfragen an %2$@ hinzu. Die Erweiterung sieht es nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Volant keeps it in your Keychain and adds it only to requests to %2$@. The extension never sees it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ Volant la guarda en tu Llavero y solo la añade a las solicitudes a %2$@. La extensión nunca la ve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ Volant le conserve dans votre trousseau et ne l’ajoute qu’aux requêtes vers %2$@. L’extension ne le voit jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ Volant lo conserva nel Portachiavi e lo aggiunge solo alle richieste a %2$@. L’estensione non lo vede mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ Volantはこれをキーチェーンに保管し、%2$@へのリクエストにのみ追加します。機能拡張からは見えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ Volant가 키체인에 보관하며 %2$@에 보내는 요청에만 추가합니다. 확장 프로그램은 이 값을 볼 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ Volant bewaart dit in je sleutelhanger en voegt het alleen toe aan verzoeken naar %2$@. De extensie ziet het nooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ Volant przechowuje go w pęku kluczy i dodaje tylko do żądań wysyłanych do %2$@. Rozszerzenie nigdy go nie widzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ O Volant guarda isso no seu Chaveiro e o adiciona apenas a solicitações para %2$@. A extensão nunca o vê."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ Volant хранит его в Связке ключей и добавляет только к запросам на %2$@. Расширение его не видит."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ Volant bunu Anahtar Zinciri’nizde saklar ve yalnızca şu adrese yapılan isteklere ekler: %2$@. Genişletme bunu hiçbir zaman görmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ Volant зберігає його у Зв’язці ключів і додає лише до запитів до %2$@. Розширення ніколи його не бачить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@Volant会将它保存在你的钥匙串中，并仅添加到发往%2$@的请求中。扩展永远不会看到它。"
          }
        }
      }
    },
