    "%@ was installed but couldn’t be loaded. Check the Extensions folder.": {
      "comment": "Extension catalog error",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ se instaló, pero no se pudo cargar. Revisa la carpeta Extensiones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ wurde installiert, konnte aber nicht geladen werden. Prüfe den Ordner „Extensions“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ è stata installata ma non è stato possibile caricarla. Controlla la cartella Estensioni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ a été installée mais n’a pas pu être chargée. Vérifiez le dossier Extensions."
          }
        }
      }
    },
    "%@ was withdrawn from the extension catalog. Update or uninstall it.": {
      "comment": "Extension error; the value is the extension name",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ se retiró del catálogo de extensiones. Actualízala o desinstálala."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ wurde aus dem Erweiterungskatalog zurückgezogen. Aktualisiere oder deinstalliere die Erweiterung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ è stata ritirata dal catalogo delle estensioni. Aggiornala o disinstallala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ a été retirée du catalogue d’extensions. Mettez-la à jour ou désinstallez-la."
          }
        }
      }
    },
    "%@ was withdrawn from the extension catalog: %@ Update or uninstall it.": {
      "comment": "Extension error; the values are the extension name and the catalog's reason",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ was withdrawn from the extension catalog: %2$@ Update or uninstall it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ se retiró del catálogo de extensiones: %2$@ Actualízala o desinstálala."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ wurde aus dem Erweiterungskatalog zurückgezogen: %2$@ Aktualisiere oder deinstalliere die Erweiterung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ è stata ritirata dal catalogo delle estensioni: %2$@ Aggiornala o disinstallala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ a été retirée du catalogue d’extensions : %2$@ Mettez-la à jour ou désinstallez-la."
          }
        }
      }
    },
    "%@ · %@ · Muted": {
