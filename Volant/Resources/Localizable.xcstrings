    "%@, hidden behind the zoomed pane, %@": {
      "comment": "Rex Overview accessibility label: pane name, then its state",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, hidden behind the zoomed pane, %2$@"
