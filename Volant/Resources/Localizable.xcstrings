    "Clipboard history can’t access its encryption key. Unlock your login Keychain or allow access, then retry." : {
      "comment" : "Clipboard history error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Verlauf der Zwischenablage kann nicht auf seinen Schlüssel zugreifen. Entsperre deinen Anmeldeschlüsselbund oder erlaube den Zugriff und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El historial del portapapeles no puede acceder a su clave de cifrado. Desbloquea el llavero de inicio de sesión o permite el acceso y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’historique du presse-papiers ne peut pas accéder à sa clé de chiffrement. Déverrouillez votre trousseau de session ou autorisez l’accès, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La cronologia degli appunti non può accedere alla sua chiave di crittografia. Sblocca il Portachiavi login o consenti l’accesso, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "クリップボード履歴が暗号化キーにアクセスできません。ログインキーチェーンのロックを解除するかアクセスを許可してから、再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "클립보드 기록이 암호화 키에 접근할 수 없습니다. 로그인 키체인을 잠금 해제하거나 접근을 허용한 후 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Klembordgeschiedenis heeft geen toegang tot de coderingssleutel. Ontgrendel je inlogsleutelhanger of sta toegang toe en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Historia schowka nie ma dostępu do klucza szyfrowania. Odblokuj pęk kluczy logowania lub zezwól na dostęp, a następnie spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O histórico da área de transferência não consegue acessar sua chave de criptografia. Desbloqueie o chaveiro de início de sessão ou permita o acesso e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "История буфера обмена не может получить ключ шифрования. Разблокируйте связку ключей входа или разрешите доступ, затем повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pano geçmişi şifreleme anahtarına erişemiyor. Giriş Anahtar Zinciri’nizin kilidini açın veya erişime izin verin, sonra yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Історія буфера обміну не має доступу до ключа шифрування. Розблокуйте Зв’язку ключів входу або дозвольте доступ, а потім повторіть спробу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "剪贴板历史记录无法访问其加密密钥。请解锁你的登录钥匙串或允许访问，然后重试。"
          }
        }
      }
    },
    "Clipboard history’s encryption key couldn’t be read. Existing history has been preserved. Check Keychain access, then retry." : {
      "comment" : "Clipboard history error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Schlüssel des Zwischenablageverlaufs konnte nicht gelesen werden. Der vorhandene Verlauf bleibt erhalten. Prüfe den Schlüsselbundzugriff und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudo leer la clave de cifrado del historial del portapapeles. Se conservó el historial existente. Revisa el acceso al Llavero y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La clé de chiffrement de l’historique du presse-papiers n’a pas pu être lue. L’historique existant a été conservé. Vérifiez l’accès au trousseau, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impossibile leggere la chiave di crittografia della cronologia degli appunti. La cronologia esistente è stata conservata. Controlla l’accesso al Portachiavi, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "クリップボード履歴の暗号化キーを読み取れませんでした。既存の履歴は保持されています。キーチェーンへのアクセスを確認してから、再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "클립보드 기록의 암호화 키를 읽을 수 없습니다. 기존 기록은 보존되었습니다. 키체인 접근을 확인한 후 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De coderingssleutel van de klembordgeschiedenis kon niet worden gelezen. De bestaande geschiedenis is behouden. Controleer de toegang tot de sleutelhanger en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie można odczytać klucza szyfrowania historii schowka. Istniejącą historię zachowano. Sprawdź dostęp do pęku kluczy, a następnie spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Não foi possível ler a chave de criptografia do histórico da área de transferência. O histórico existente foi preservado. Verifique o acesso ao Chaveiro e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не удалось прочитать ключ шифрования истории буфера обмена. Существующая история сохранена. Проверьте доступ к Связке ключей и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pano geçmişinin şifreleme anahtarı okunamadı. Mevcut geçmiş korundu. Anahtar Zinciri erişimini denetleyin, sonra yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не вдалося прочитати ключ шифрування історії буфера обміну. Наявну історію збережено. Перевірте доступ до Зв’язки ключів, а потім повторіть спробу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
