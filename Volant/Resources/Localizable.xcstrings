    "Allow Bluetooth access to list connected devices.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite el acceso a Bluetooth para mostrar los dispositivos conectados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaube den Bluetooth-Zugriff, um verbundene Geräte anzuzeigen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consenti l’accesso Bluetooth per elencare i dispositivi connessi."
          }
