    "Version %@ is installed. Updating replaces it in one step; changed code, permissions or hosts need enabling again." : {
      "comment" : "Extension catalog detail, On this Mac section; the value is the installed version",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Version %@ ist installiert. Aktualisieren ersetzt sie in einem Schritt; geänderter Code, Berechtigungen oder Hosts müssen erneut aktiviert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La versión %@ está instalada. Al actualizar se reemplaza en un solo paso; si cambian el código, los permisos o los hosts, hay que volver a activarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La version %@ est installée. La mise à jour la remplace en une seule étape ; un code, des autorisations ou des hôtes modifiés doivent être réactivés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La versione %@ è installata. L’aggiornamento la sostituisce in un solo passaggio; codice, permessi o host modificati vanno riattivati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "バージョン%@がインストールされています。アップデートすると1回の操作で置き換えられます。コード、権限、ホストが変更された場合は再度有効にする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "버전 %@ 설치됨. 업데이트하면 한 번에 대체되며, 코드, 권한 또는 호스트가 변경된 경우 다시 활성화해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Versie %@ is geïnstalleerd. Bijwerken vervangt deze in één stap; gewijzigde code, toestemmingen of hosts moeten opnieuw worden ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zainstalowana jest wersja %@. Uaktualnienie zastępuje ją w jednym kroku; zmieniony kod, uprawnienia lub hosty wymagają ponownego włączenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A versão %@ está instalada. Atualizar a substitui em uma etapa; código, permissões ou hosts alterados precisam ser ativados novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Установлена версия %@. Обновление заменяет ее за один шаг; измененный код, разрешения или хосты нужно включить снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sürüm %@ yüklü. Güncelleme onu tek adımda değiştirir; değişen kod, izinler veya sunucular yeniden etkinleştirilmelidir."
          }
        },
        "uk" : {
          "stringUnit" : {
