    "Synced settings exceed iCloud's 1 MB limit. Remove large snippets to resume syncing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die synchronisierten Einstellungen überschreiten das iCloud-Limit von 1 MB. Entferne große Textbausteine, um die Synchronisierung fortzusetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los ajustes sincronizados superan el límite de 1 MB de iCloud. Elimina fragmentos grandes para reanudar la sincronización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les réglages synchronisés dépassent la limite de 1 Mo d’iCloud. Supprimez les extraits volumineux pour reprendre la synchronisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le impostazioni sincronizzate superano il limite di 1 MB di iCloud. Rimuovi i frammenti più grandi per riprendere la sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "同期する設定がiCloudの1 MBの上限を超えています。同期を再開するには、大きなスニペットを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "동기화된 설정이 iCloud의 1MB 제한을 초과합니다. 동기화를 재개하려면 큰 스니펫을 제거하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gesynchroniseerde instellingen overschrijden de limiet van 1 MB van iCloud. Verwijder grote fragmenten om de synchronisatie te hervatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Synchronizowane ustawienia przekraczają limit 1 MB w iCloud. Usuń duże fragmenty, aby wznowić synchronizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os ajustes sincronizados excedem o limite de 1 MB do iCloud. Remova trechos grandes para retomar a sincronização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Синхронизируемые настройки превышают лимит iCloud в 1 МБ. Удалите большие фрагменты, чтобы возобновить синхронизацию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eşzamanlanan ayarlar iCloud’un 1 MB sınırını aşıyor. Eşzamanlamayı sürdürmek için büyük parçaları kaldırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Синхронізовані параметри перевищують обмеження iCloud в 1 МБ. Вилучіть великі фрагменти, щоб відновити синхронізацію."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "同步的设置超过了iCloud的1 MB限制。请移除较大的片段以恢复同步。"
          }
        }
      }
    },
