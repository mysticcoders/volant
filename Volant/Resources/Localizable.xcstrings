{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "shouldTranslate": false
    },
    " and ": {
      "comment": "Separator between access token names in an extension error, with its spaces",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": " y "
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": " und "
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": " e "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " et "
          }
        }
      }
    },
    "%@ %@ asks for new access, so it is off. Turn it on to review it.": {
      "comment": "Settings → Extensions notice; the values are the extension name and version",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ asks for new access, so it is off. Turn it on to review it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ %2$@ solicita nuevos accesos, así que está desactivada. Actívala para revisarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ %2$@ fordert neuen Zugriff an und ist daher aus. Schalte es ein, um es zu prüfen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ %2$@ richiede nuovi accessi, quindi è disattivata. Attivala per esaminarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ %2$@ demande un nouvel accès, elle est donc désactivée. Activez-la pour l’examiner."
          }
        }
      }
    },
    "%@ %@ was withdrawn from the catalog and can’t be installed.": {
      "comment": "Extension catalog error; the values are the extension name and version",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ was withdrawn from the catalog and can’t be installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ %2$@ se retiró del catálogo y no se puede instalar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ %2$@ wurde aus dem Katalog zurückgezogen und kann nicht installiert werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ %2$@ è stata ritirata dal catalogo e non può essere installata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ %2$@ a été retirée du catalogue et ne peut pas être installée."
          }
        }
      }
    },
    "%@ New copies aren’t being saved.": {
      "comment": "Clipboard history status; the value is the error that stopped it",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ No se están guardando las nuevas copias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Neue Kopien werden nicht gesichert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Le nuove copie non vengono salvate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Les nouvelles copies ne sont pas enregistrées."
          }
        }
      }
    },
    "%@ Volant keeps it in your Keychain and adds it only to requests to %@. The extension never sees it.": {
      "comment": "Extension token field note; the values are the extension's own help text and a web host",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ Volant keeps it in your Keychain and adds it only to requests to %2$@. The extension never sees it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ Volant la guarda en tu Llavero y solo la añade a las solicitudes a %2$@. La extensión nunca la ve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ Volant bewahrt es in deinem Schlüsselbund auf und fügt es nur Anfragen an %2$@ hinzu. Die Erweiterung sieht es nie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ Volant lo conserva nel Portachiavi e lo aggiunge solo alle richieste a %2$@. L’estensione non lo vede mai."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ Volant le conserve dans votre trousseau et ne l’ajoute qu’aux requêtes vers %2$@. L’extension ne le voit jamais."
          }
        }
      }
    },
    "%@ alias": {
      "comment": "Accessibility label of an app's alias field in App Shortcuts; the value is the app name",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alias de %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alias für %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alias di %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alias de %@"
          }
        }
      }
    },
    "%@ appearance": {
      "comment": "Accessibility label of an appearance tile; the value is System, Light or Dark",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aspecto %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erscheinungsbild %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aspetto %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apparence %@"
          }
        }
      }
    },
    "%@ color theme": {
      "comment": "Accessibility label of a color theme tile; the value is the theme name",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tema de color %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farbthema %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tema colori %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thème de couleur %@"
          }
        }
      }
    },
    "%@ disconnected during dictation, so its volume wasn’t restored. Check its volume when you reconnect it.": {
      "comment": "The name is an audio output device",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ se desconectó durante el dictado, así que no se restauró su volumen. Revisa su volumen cuando lo vuelvas a conectar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ wurde während des Diktierens getrennt, daher wurde die Lautstärke nicht wiederhergestellt. Prüfe die Lautstärke, wenn du es wieder verbindest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ si è disconnesso durante la dettatura, quindi il volume non è stato ripristinato. Controllane il volume quando lo ricolleghi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ s’est déconnecté pendant la dictée, son volume n’a donc pas été rétabli. Vérifiez son volume lorsque vous le reconnecterez."
          }
        }
      }
    },
    "%@ equals %@": {
      "comment": "Accessibility label for a calculator answer",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ equals %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ es igual a %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ergibt %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ uguale a %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ égale %2$@"
          }
        }
      }
    },
    "%@ is a dark theme, so Volant stays dark while it is selected. Choose System or Volant to use this setting.": {
      "comment": "Appearance settings footer; the value is a color theme name",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ es un tema oscuro, así que Volant se mantiene oscuro mientras esté seleccionado. Elige Sistema o Volant para usar este ajuste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ist ein dunkles Thema, daher bleibt Volant dunkel, solange es ausgewählt ist. Wähle „System“ oder „Volant“, um diese Einstellung zu verwenden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ è un tema scuro, quindi Volant resta scuro finché è selezionato. Scegli Sistema o Volant per usare questa impostazione."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ est un thème sombre : Volant reste sombre tant qu’il est sélectionné. Choisissez Système ou Volant pour utiliser ce réglage."
          }
        }
      }
    },
    "%@ is a light theme, so Volant stays light while it is selected. Choose System or Volant to use this setting.": {
      "comment": "Appearance settings footer; the value is a color theme name",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ es un tema claro, así que Volant se mantiene claro mientras esté seleccionado. Elige Sistema o Volant para usar este ajuste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ist ein helles Thema, daher bleibt Volant hell, solange es ausgewählt ist. Wähle „System“ oder „Volant“, um diese Einstellung zu verwenden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ è un tema chiaro, quindi Volant resta chiaro finché è selezionato. Scegli Sistema o Volant per usare questa impostazione."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ est un thème clair : Volant reste clair tant qu’il est sélectionné. Choisissez Système ou Volant pour utiliser ce réglage."
          }
        }
      }
    },
    "%@ is bundled with Volant and can’t be replaced.": {
      "comment": "Extension catalog error",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ viene incluida con Volant y no se puede reemplazar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ist in Volant enthalten und kann nicht ersetzt werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ è incluso in Volant e non può essere sostituito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ est fournie avec Volant et ne peut pas être remplacée."
          }
        }
      }
    },
    "%@ is disabled.": {
      "comment": "A Herdr machine was turned off",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ está desactivada."
