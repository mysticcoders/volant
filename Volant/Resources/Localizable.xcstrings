    "Allow Bluetooth access to list connected devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erlaube den Bluetooth-Zugriff, um verbundene Geräte anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite el acceso a Bluetooth para mostrar los dispositivos conectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Autorisez l’accès Bluetooth pour lister les appareils connectés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Consenti l’accesso Bluetooth per elencare i dispositivi connessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "接続中のデバイスを一覧表示するには、Bluetoothへのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "연결된 기기를 나열하려면 Bluetooth 접근을 허용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geef Bluetooth-toegang om verbonden apparaten weer te geven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zezwól na dostęp do Bluetooth, aby wyświetlić podłączone urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permita o acesso ao Bluetooth para listar os dispositivos conectados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Разрешите доступ к Bluetooth, чтобы показать подключенные устройства."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bağlı aygıtları listelemek için Bluetooth erişimine izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дозвольте доступ до Bluetooth, щоб показати під’єднані пристрої."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "允许蓝牙访问以列出已连接的设备。"
          }
        }
      }
    },
    "Allow Location access to show Wi-Fi network names. Showing Wi-Fi never reads your coordinates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erlaube den Zugriff auf den Standort, um WLAN-Namen anzuzeigen. Beim Anzeigen von WLAN werden nie deine Koordinaten gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite el acceso a la ubicación para mostrar los nombres de las redes Wi-Fi. Mostrar las redes Wi-Fi nunca lee tus coordenadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Autorisez l’accès à la localisation pour afficher les noms des réseaux Wi-Fi. L’affichage du Wi-Fi ne lit jamais vos coordonnées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Consenti l’accesso alla posizione per mostrare i nomi delle reti Wi-Fi. Mostrare le reti Wi-Fi non legge mai le tue coordinate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wi-Fiネットワーク名を表示するには、位置情報へのアクセスを許可してください。Wi-Fiの表示で座標が読み取られることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wi-Fi 네트워크 이름을 표시하려면 위치 접근을 허용하십시오. Wi-Fi 표시 시 사용자의 좌표는 읽지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geef toegang tot locatie om namen van wifinetwerken te tonen. Wifi tonen leest nooit je coördinaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zezwól na dostęp do lokalizacji, aby pokazać nazwy sieci Wi-Fi. Wyświetlanie Wi-Fi nigdy nie odczytuje współrzędnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permita o acesso à Localização para mostrar os nomes das redes Wi-Fi. Mostrar o Wi-Fi nunca lê suas coordenadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Разрешите доступ к геопозиции, чтобы показать названия сетей Wi-Fi. Для показа Wi-Fi ваши координаты не считываются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wi-Fi ağ adlarını göstermek için Konum erişimine izin verin. Wi-Fi gösterimi koordinatlarınızı hiçbir zaman okumaz."
          }
        },
        "uk" : {
