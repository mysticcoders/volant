          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Volant guarda isso no seu Chaveiro e o adiciona apenas a solicitações para %@. A extensão nunca o vê."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volant хранит его в Связке ключей и добавляет только к запросам на %@. Расширение его не видит."
