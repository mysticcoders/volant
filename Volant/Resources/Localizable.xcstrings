    "Deletes this extension’s tokens from your Keychain; it asks again on next use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Löscht die Tokens dieser Erweiterung aus deinem Schlüsselbund; bei der nächsten Nutzung wird erneut gefragt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina los tokens de esta extensión de tu Llavero; los volverá a pedir en el próximo uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprime les jetons de cette extension de votre trousseau ; elle les redemandera à la prochaine utilisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina i token di questa estensione dal Portachiavi; li richiederà al prossimo utilizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この機能拡張のトークンをキーチェーンから削除します。次回使用時に再度要求されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "키체인에서 이 확장 프로그램의 토큰을 삭제합니다. 다음 사용 시 다시 요청합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verwijdert de tokens van deze extensie uit je sleutelhanger; bij volgend gebruik wordt er opnieuw om gevraagd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usuwa tokeny tego rozszerzenia z pęku kluczy; przy następnym użyciu poprosi o nie ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apaga os tokens desta extensão do seu Chaveiro; ela pedirá novamente no próximo uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Удаляет токены этого расширения из Связки ключей; при следующем использовании оно запросит их снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu genişletmenin belirteçlerini Anahtar Zinciri’nizden siler; bir sonraki kullanımda yeniden sorar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Видаляє токени цього розширення зі Зв’язки ключів; воно запитає знову під час наступного використання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "从你的钥匙串中删除此扩展的令牌；下次使用时会再次询问。"
          }
        }
      }
    },
