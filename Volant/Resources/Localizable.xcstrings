            "state": "needs_review",
            "value": "%1$@, oculto tras el panel ampliado, %2$@"
          }
        }
      }
    },
    "%@: %@": {
      "comment": "Extension load problem; the values are the folder name and the reason\nFooter feedback after choosing an audio device, such as Audio Output: Speakers\nSettings error for an app shortcut; the values are the app's bundle identifier and the reason",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$@"
          }
        }
      },
      "shouldTranslate": false
    },
    "%@: %lld malformed entries skipped.": {
      "comment": "Raycast import report line",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
