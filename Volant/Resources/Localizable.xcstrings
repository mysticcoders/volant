    "Installed %@. Choose Turn On to use it." : {
      "comment" : "Extension catalog feedback; the value is the extension name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ installiert. Wähle „Einschalten“, um es zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ instalada. Elige Activar para usarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ installée. Choisissez Activer pour l’utiliser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ installata. Scegli Attiva per usarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@をインストールしました。使用するには「オンにする」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 설치됨. 사용하려면 켜기를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ geïnstalleerd. Kies Zet aan om de extensie te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zainstalowano %@. Wybierz Włącz, aby go używać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ instalada. Escolha Ativar para usá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ установлено. Выберите «Включить», чтобы использовать его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yüklendi: %@. Kullanmak için Aç’ı seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ інстальовано. Виберіть «Увімкнути», щоб використовувати його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "已安装%@。选择“打开”以使用它。"
          }
        }
      }
    },
    "Installed and off, so it doesn’t appear in search. Choose Turn On to allow it; it asks for any hosts first." : {
      "comment" : "Extension catalog detail, On this Mac section",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Installiert und aus, daher erscheint es nicht in der Suche. Wähle „Einschalten“, um es zu erlauben; es fragt zuerst nach allen Hosts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Instalada y desactivada, por lo que no aparece en la búsqueda. Elige Activar para permitirla; antes pedirá acceso a los hosts que necesite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Installée et désactivée, elle n’apparaît donc pas dans la recherche. Choisissez Activer pour l’autoriser ; elle demande d’abord l’accès aux hôtes éventuels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Installata e disattivata, quindi non compare nella ricerca. Scegli Attiva per consentirla; prima chiederà gli eventuali host."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "インストール済みでオフのため、検索には表示されません。許可するには「オンにする」を選択してください。最初にホストへのアクセスを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "설치되었지만 꺼져 있어 검색에 나타나지 않습니다. 허용하려면 켜기를 선택하십시오. 먼저 필요한 호스트에 대해 묻습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geïnstalleerd en uit, dus niet zichtbaar in zoekresultaten. Kies Zet aan om de extensie toe te staan; eerst wordt om eventuele hosts gevraagd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zainstalowane i wyłączone, więc nie pojawia się w wyszukiwaniu. Wybierz Włącz, aby na nie zezwolić; najpierw poprosi o dostęp do hostów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Instalada e desativada, por isso não aparece na busca. Escolha Ativar para permiti-la; ela pedirá acesso a hosts primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Установлено и выключено, поэтому не показывается в поиске. Выберите «Включить», чтобы разрешить его; сначала оно запросит доступ к хостам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yüklü ve kapalı, bu nedenle aramada görünmüyor. İzin vermek için Aç’ı seçin; önce gereken sunucular için izin ister."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Інстальовано й вимкнено, тому воно не з’являється в пошуку. Виберіть «Увімкнути», щоб дозволити його; спершу воно запитає доступ до хостів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "已安装但处于关闭状态，因此不会出现在搜索中。选择“打开”以允许它；它会先请求所需的主机。"
          }
        }
      }
    },
    "Installed and on. Type %@ in the launcher." : {
