          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zobacz, co można przenieść do Volant. Istniejące elementy zostaną zachowane, a przed importem zostanie utworzona kopia zapasowa do odzyskiwania."
          }
        },
        "pt-BR" : {
