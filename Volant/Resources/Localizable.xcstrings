          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pfeiltasten wechseln zwischen Tabs und Bereichen, Tab springt zum nächsten wartenden Bereich, Leertaste minimiert oder erweitert die Sitzung, Return fokussiert sie in Rex"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I tasti freccia spostano tra pannelli e schede, Tab passa al pannello in attesa successivo, Spazio riduce o espande la sessione, A capo la mette in primo piano in Rex"
          }
        },
        "fr": {
          "stringUnit": {
