          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippe den Namen des Quicklinks, ein Leerzeichen und einen Begriff, der {query} ersetzt. Öffnet http-, https-, mailto- und Kurzbefehle-Run-Links."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
