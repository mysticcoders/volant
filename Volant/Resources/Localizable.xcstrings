    "Connects to a model server already running on this Mac. Detection lists available models; it does not load or download them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se conecta a un servidor de modelos que ya esté en ejecución en este Mac. La detección muestra los modelos disponibles; no los carga ni los descarga."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbindet sich mit einem Modellserver, der bereits auf diesem Mac läuft. Die Erkennung listet verfügbare Modelle auf; sie lädt oder installiert sie nicht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
