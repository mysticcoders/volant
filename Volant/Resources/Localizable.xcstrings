          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tapez le nom du lien rapide, une espace et un terme pour remplacer {query}. Ouvre les liens http, https, mailto et d’exécution de Raccourcis."
          }
        }
      }
    },
    "Type this alias in Volant, then press Return. Clearing it removes this alias; other aliases are preserved.": {
