    "Plays audio at a fifth of its volume while listening, then restores it unless you changed it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spielt Audio beim Zuhören mit einem Fünftel der Lautstärke ab und stellt sie dann wieder her, sofern du sie nicht geändert hast."
          }
        },
        "es" : {
          "stringUnit" : {
