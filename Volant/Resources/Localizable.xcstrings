    "Reviewed and signed for Volant; each download is checked against the signed catalog. Installing never turns an extension on or runs it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revisadas y firmadas para Volant; cada descarga se comprueba con el catálogo firmado. Instalar nunca activa ni ejecuta una extensión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Für Volant geprüft und signiert; jeder Download wird mit dem signierten Katalog abgeglichen. Die Installation aktiviert oder startet eine Erweiterung nie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verificate e firmate per Volant; ogni download viene controllato rispetto al catalogo firmato. L’installazione non attiva né esegue mai un’estensione."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifiées et signées pour Volant ; chaque téléchargement est contrôlé par rapport au catalogue signé. L’installation n’active ni n’exécute jamais une extension."
          }
        }
      }
    },
