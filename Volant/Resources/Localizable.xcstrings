        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volant bunu Anahtar Zinciri’nizde saklar ve yalnızca şu adrese yapılan isteklere ekler: %@. Genişletme bunu hiçbir zaman görmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volant зберігає його у Зв’язці ключів і додає лише до запитів до %@. Розширення ніколи його не бачить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
