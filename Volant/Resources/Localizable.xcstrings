    "%@ is a dark theme, so Volant stays dark while it is selected. Choose System or Volant to use this setting." : {
      "comment" : "Appearance settings footer; the value is a color theme name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ist ein dunkles Thema, daher bleibt Volant dunkel, solange es ausgewählt ist. Wähle „System“ oder „Volant“, um diese Einstellung zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ es un tema oscuro, así que Volant se mantiene oscuro mientras esté seleccionado. Elige Sistema o Volant para usar este ajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ est un thème sombre : Volant reste sombre tant qu’il est sélectionné. Choisissez Système ou Volant pour utiliser ce réglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ è un tema scuro, quindi Volant resta scuro finché è selezionato. Scegli Sistema o Volant per usare questa impostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@はダークテーマのため、選択中はVolantはダークのままです。この設定を使うには「システム」または「Volant」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 테마는 어두운 테마이므로 선택되어 있는 동안 Volant는 어둡게 유지됩니다. 이 설정을 사용하려면 시스템 또는 Volant를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ is een donker thema, dus Volant blijft donker zolang het is geselecteerd. Kies Systeem of Volant om deze instelling te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ to ciemny motyw, więc Volant pozostaje ciemny, gdy jest on wybrany. Wybierz System lub Volant, aby użyć tego ustawienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ é um tema escuro, então o Volant permanece escuro enquanto ele estiver selecionado. Escolha Sistema ou Volant para usar este ajuste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ — темная тема, поэтому Volant остается темным, пока она выбрана. Выберите «Системная» или «Volant», чтобы использовать этот параметр."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ koyu bir tema, bu nedenle seçili olduğu sürece Volant koyu kalır. Bu ayarı kullanmak için Sistem veya Volant seçeneğini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ — темна тема, тому Volant залишається темним, поки її вибрано. Виберіть «Системний» або Volant, щоб використати цей параметр."
