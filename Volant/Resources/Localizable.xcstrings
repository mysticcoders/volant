            "state" : "needs_review",
            "value" : "Optional. Durch Kommas trennen. Jedes wird als ganzes Wort durch das Wort oben ersetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opcional. Separar con comas. Cada una se reemplaza por la palabra de arriba, como palabra completa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Facultatif. Séparez par des virgules. Chacun est remplacé par le mot ci-dessus, en mots entiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Facoltativo. Separa con virgole. Ognuna viene sostituita con la parola sopra, solo come parola intera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "オプション。カンマで区切ります。それぞれが単語単位で上の単語に置き換えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "선택 사항. 쉼표로 구분하십시오. 각 항목은 완전한 단어 단위로 위의 단어로 대체됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Optioneel. Scheid met komma's. Elk wordt als heel woord vervangen door het woord hierboven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opcjonalne. Rozdziel przecinkami. Każde jest zastępowane powyższym słowem, jako całe słowa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opcional. Separe com vírgulas. Cada uma é substituída pela palavra acima, como palavras inteiras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Необязательно. Разделяйте запятыми. Каждое заменяется словом выше как целое слово."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İsteğe bağlı. Virgülle ayırın. Her biri, tam sözcük olarak yukarıdaki sözcükle değiştirilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Необов’язково. Розділяйте комами. Кожне замінюється словом вище як ціле слово."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "可选。用逗号分隔。每一项都会作为完整单词被替换为上方的字词。"
          }
        }
      }
    },
