    "Optional. Separate with commas. Each is replaced with the word above, as whole words.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opcional. Separar con comas. Cada una se reemplaza por la palabra de arriba, como palabra completa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Optional. Durch Kommas trennen. Jedes wird als ganzes Wort durch das Wort oben ersetzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Facoltativo. Separa con virgole. Ognuna viene sostituita con la parola sopra, solo come parola intera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Facultatif. Séparez par des virgules. Chacun est remplacé par le mot ci-dessus, en mots entiers."
          }
        }
