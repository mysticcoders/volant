<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Volant</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.mysticcoders.volant</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Volant</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Volant lists connected Bluetooth devices when you open the Bluetooth command.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Volant lists connected Bluetooth devices on request.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Volant shows today's events and their meeting links. Read-only.</string>
	<key>NSContactsUsageDescription</key>
	<string>Volant searches your contacts so you can copy an email address or phone number. Read-only.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright 2026 Mystic Coders, LLC</string>
	<key>NSLocationUsageDescription</key>
	<string>macOS requires Location access to show Wi-Fi network names. Volant does not request your coordinates.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>macOS requires Location access to show Wi-Fi network names. Volant does not request your coordinates.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>SUEnableDownloaderService</key>
	<true/>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUFeedURL</key>
	<string>$(VOLANT_UPDATE_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(VOLANT_UPDATE_PUBLIC_KEY)</string>
</dict>
</plist>
